{
  "name": "content-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @content-lab/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "worker:dev": "pnpm --filter @content-lab/worker dev",
    "db:check": "bash scripts/db-check.sh",
    "db:types": "node scripts/gen-db-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "pg": "^8.16.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
