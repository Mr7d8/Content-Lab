# Copy to .env (worker, scripts) and apps/web/.env.local (dashboard).
# Real keys live only in those files, Vercel and Apify. Never commit them.

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Worker and server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Apify (free plan credit)
APIFY_TOKEN=
# The deployed worker actor, e.g. yourname~content-lab-worker
APIFY_WORKER_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
# Creative Center links: set once an actor is picked and checked on one URL
APIFY_CREATIVE_CENTER_ACTOR_ID=

# AI providers (all behind packages/core/src/ai)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional override of the default Gemini model in packages/core
GEMINI_MODEL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Only needed when a provider below is set to claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
VISION_PROVIDER=gemini
BRIEF_PROVIDER=gemini

# Free-tier pacing, requests per minute. Lower these to match your account.
GROQ_REQUESTS_PER_MINUTE=20
GEMINI_REQUESTS_PER_MINUTE=10
