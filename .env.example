# Copy to .env (worker, scripts) and apps/web/.env.local (dashboard).
# In production every key lives in Vercel: the dashboard passes the worker's
# keys to the Apify actor on each start (secret fields, stored encrypted).
# Never commit real keys.

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: public dashboard URL used in magic link redirects
NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
# Server only (worker, and the dashboard that passes it on). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Apify (free plan credit)
APIFY_TOKEN=
# The deployed worker actor, e.g. yourname~content-lab-worker
APIFY_WORKER_ACTOR_ID=
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
# Creative Center searches (default fetch_cat~tiktok-ads-library-scraper)
APIFY_CREATIVE_CENTER_ACTOR_ID=
# Dashboard: Vercel Cron sends it to /api/cron/sweep for the daily research sweep
CRON_SECRET=

# AI providers (all behind packages/core/src/ai)
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional override of the default Gemini model in packages/core
GEMINI_MODEL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Only needed when a provider below is set to claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
VISION_PROVIDER=gemini
BRIEF_PROVIDER=gemini

# Free-tier pacing, requests per minute. Lower these to match your account.
GROQ_REQUESTS_PER_MINUTE=20
GEMINI_REQUESTS_PER_MINUTE=10
