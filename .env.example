# Copy to apps/web/.env.local for local development. In production every key
# lives in Vercel (Project settings > Environment Variables). Never commit real keys.

# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: public dashboard URL, for magic links and the Apify webhook.
# On Vercel the production URL is used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Apify: scans run the scrapers directly (pay per result)
APIFY_TOKEN=
# Optional overrides of the scrapers
APIFY_CREATIVE_CENTER_ACTOR_ID=fetch_cat~tiktok-ads-library-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
APIFY_META_ACTOR_ID=curious_coder~facebook-ads-library-scraper

# Vercel Cron sends it to /api/cron/sweep for the daily scheduled scans; it
# also signs the Apify webhook that finishes a scan when no board is open.
CRON_SECRET=

# AI (packages/core/src/ai). Decoding needs Gemini with billing on.
GEMINI_API_KEY=
# Optional: pin a Gemini model (default gemini-flash-latest)
GEMINI_MODEL=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0

# Brief writing (not on the board yet): gemini or claude
BRIEF_PROVIDER=gemini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_REQUESTS_PER_MINUTE=10
